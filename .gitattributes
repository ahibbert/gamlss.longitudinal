# Normalize line endings to LF in the repository
* text=auto eol=lf

# R source files — always LF
*.R text eol=lf
*.Rd text eol=lf
*.Rmd text eol=lf

# Data/lock files — always LF
*.lock text eol=lf

# Windows scripts — CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no conversion
*.RData binary
*.rda binary
*.rds binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Signed production evidence is byte-addressed by detached attestations.
# Preserve its generated bytes identically on Windows and Unix checkouts.
paper/data/public-derived/copula-misspecification/*.csv -text
